# Copy to .env (gitignored) and adjust as needed.
# Local Docker Postgres — TWO separate clusters as of ADR-032 (correcting ADR-029), not one:
# Postgres ROLES are cluster-wide, not per-database. `db` (port 5432, docker-compose service `db`)
# is the REAL development catalog and hosts the distinct approval/review-coordinator/export-reader
# logins below. `db-test` (port 5433, service `db-test`) is pytest's isolated, disposable
# `semiskill_test` database on its OWN cluster — it must never share a cluster with `db`'s
# operational logins, or migration-checkpoint attestation tests (tests/artifacts/
# test_forward_migration.py) that assert an exact role/membership set will fail.
# Use 127.0.0.1, not localhost: on Windows localhost prefers IPv6 (::1) and stalls ~30s per
# connection against the IPv4-bound docker DB.
DATABASE_URL=postgresql://semiskill:semiskill@127.0.0.1:5432/semiskill
TEST_DATABASE_URL=postgresql://semiskill:semiskill@127.0.0.1:5433/semiskill_test

# IMPORTANT — pytest must run WITHOUT the three SEMISKILL_*_DATABASE_URL lines below exported,
# even though `.env` documents them together for CLI convenience. PostgresArtifactStore.__init__
# reads them unconditionally from the environment, including for a store constructed against the
# isolated test database — the test fixtures (tests/conftest.py `_test_capability_lease`) grant
# the SAME test session user all four capability roles specifically so one DSN can act as every
# actuator during tests. If these three vars are set, a test-DB store silently redirects its
# approval/review/export calls to the REAL `db` cluster instead, causing confusing cross-database
# failures ("skill binding is invalid" etc.) that have nothing to do with the code under test.
# Export only TEST_DATABASE_URL when running pytest; export the full file for CLI/dev operations.

# Local-development migration control plane. The owner is accepted only for the explicit,
# digest-confirmed development checkpoint; production requires a distinct provisioned identity.
SEMISKILL_MIGRATION_DATABASE_URL=postgresql://semiskill:semiskill@127.0.0.1:5432/semiskill
SEMISKILL_MIGRATOR_ROLE=semiskill
SEMISKILL_DEVELOPMENT_DATABASE_NAME=semiskill
SEMISKILL_PRODUCTION_DATABASE_NAME=semiskill_production

# Required for the approval/review-issuance/export chain to run for real outside isolated tests.
# Each is a distinct login on the `db` cluster (127.0.0.1:5432) holding only its one capability
# role grant — never reuse the runtime login or another actuator's login for any of these.
# SEMISKILL_APPROVAL_DATABASE_URL=postgresql://<approval-login>:<secret>@127.0.0.1:5432/semiskill
# SEMISKILL_REVIEW_COORDINATOR_DATABASE_URL=postgresql://<review-login>:<secret>@127.0.0.1:5432/semiskill
# SEMISKILL_EXPORT_DATABASE_URL=postgresql://<export-login>:<secret>@127.0.0.1:5432/semiskill
